<main id="site__main" class="2xl:ms-[--w-side] xl:ms-[--w-side-sm] p-2.5 pl-12 h-[calc(100vh-var(--m-top))] mt-[--m-top]">
	<div class="lg:flex 2xl:gap-16 gap-12 max-w-[1065px] mx-auto" id="js-oversized">
		<div class="max-w-[680px]">
			@* stories *@
			<div class="mb-8">
				<h3 class="font-extrabold text-2xl text-black hidden">Stories</h3>
				<div class="relative" tabindex="-1" uk-slider="auto play:true; finite:true" uk-lightbox="">
					<div class="py-5 uk-slider-container">
						<ul class="uk-slider-items w-[calc(100%+14px)]" uk-scrollspy="target > li; class uk-animation-scale-up; delay:20; repeat:true">
							@* camera / add-story button *@
							<li class="md:pr-3" uk-scrollspy-class="uk-animation-fade">
								<div class="md:w-16 md:h-16 w-16 h-16 rounded-full relative border-2 border-dashed grid place-items-center bg-slate-200 border-slate-200 border-slate-300 shrink-0" uk-toggle="target: #create-story">
									<ion-icon name="camera" class="text-3xl">
									</ion-icon>
								</div>
							</li>
							@* story avatars (repeat for all three) *@
							<li class="md:pr-3 pr-3 hover:scale-[1.15] hover:-rotate-2 duration-300">
								<a href="~/images/avatar/user.png">
									<div class="md:w-16 md:h-16 w-16 h-16 relative md:border-4 border-2 shadow border-white rounded-full overflow-hidden">
										<img src="~/images/avatar/user.png" />
									</div>
								</a>
							</li>
							@* story avatars (repeat for all three) *@
							<li class="md:pr-3 pr-3 hover:scale-[1.15] hover:-rotate-2 duration-300">
								<a href="~/images/avatar/user.png">
									<div class="md:w-16 md:h-16 w-16 h-16 relative md:border-4 border-2 shadow border-white rounded-full overflow-hidden">
										<img src="~/images/avatar/user.png" />
									</div>
								</a>
							</li>
							@* story avatars (repeat for all three) *@
							<li class="md:pr-3 pr-3 hover:scale-[1.15] hover:-rotate-2 duration-300">
								<a href="~/images/avatar/user.png">
									<div class="md:w-16 md:h-16 w-16 h-16 relative md:border-4 border-2 shadow border-white rounded-full overflow-hidden">
										<img src="~/images/avatar/user.png" />
									</div>
								</a>
							</li>
							@* loading placeholder *@
							<li class="md:pr-3 pr-3">
								<div class="md:w-16 md:h-16 w-16 h-16 bg-slate-200/60 rounded-full animate-pulse">
								</div>
							</li>
						</ul>
					</div>
				</div>
			</div>

			<div class="md:max-w-[520px] max-md\:overflow-x-auto flex-1 xl:space-y-6 space-y-3">
				<div class="bg-white rounded-xl shadow-sm md:p-4 p-2 space-y-4 text-sm font-medium border1">
					<div class="flex items-center md:gap-3 gap-1">

						<div class="flex-1 bg-slate-100 hover:bg-opacity-80 transition-all rounded-lg cursor-pointer" uk-toggle="#create-status">
							<div class="py-2.5 px-3 text-slate-400">What do You have in Mind?</div>
						</div>
						<div class="cursor-pointer hover:bg-opacity-80 p-1 px-1.5 rounded-xl transition-all bg-pink-100/60 hover:bg-pink-100 text-pink-500" uk-toggle="#create-status">
							<svg fill="currentColor" class="w-5 h-5" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg">
								<title>image</title>
								<path d="M96 416Q82 416 73 407 64 398 64 384L64 128Q64 114 73 105 82 96 96 96L416 96Q430 96 439 105 448 114 448 128L448 384Q448 398 439 407 430 416 416 416L96 416ZM184 240Q204 240 218 226 232 212 232 192 232 172 218 158 204 144 184 144 164 144 150 158 136 172 136 192 136 212 150 226 164 240 184 240ZM400 368L400 304 336 240 240 336 184 279 96 368 400 368Z" />
							</svg>
						</div>
					</div>
				</div>

				<div class="bg-white rounded-xl shadow-sm md:p-4 p-2 space-y-4 text-sm font-medium border1 text-gray-600" style="580px">
					Currently there are no posts avaible. Would you like to create a new post?
				</div>

				<div class="bg-white rounded-xl shadow-sm text-sm font-medium border1">

					@* Post heading *@
					<div class="flex gap-3 sm:p-4 p-2.5 font-medium">
						<a>
							<img src="~/images/avatar/user.png" class="w-9 h-9 rounded-full">
						</a>
						<div class="flex-1">
							<a>
								<h4 class="text-black">
									Abdhullah Ariff
								</h4>
								<div class="text-xs text-gray-500">
									1 day ago
								</div>
							</a>
						</div>
						<div class="-mr-1">
							<button type="button" class="button-icon w-8 h-8 text-gray-500">
								<ion-icon class="text-xl" name="ellipsis-horizontal"></ion-icon>
							</button>
							<div class="w-[245px] !bg-white dark:!bg-white !border-slate-200 dark:!border-slate-200"
								 uk-dropdown="pos: bottom-right; animation: uk-animation-scale-up uk-transform-origin-top-right; animate-out:true; mode:click">
								<form>
									<button type="submit" class="!hover:bg-red-50 icon-link text-slate-700 dark:!text-slate-700">
										<ion-icon class="text-xl shrink-0" name="flag-outline"></ion-icon> Report
									</button>
								</form>
								<hr />
								<form>
									<button type="submit" class="!hover:bg-red-50 icon-link text-slate-700 dark:!text-slate-700">
										<ion-icon class="text-xl" name="lock-closed-outline"></ion-icon> Set as Private
									</button>
								</form>
								<hr />
								<form>
									<button type="submit" class="!hover:bg-red-50 icon-link text-slate-700 dark:!text-slate-700">
										<ion-icon class="text-xl" name="trash-bin-outline"></ion-icon> Delete Post
									</button>
								</form>
							</div>
						</div>
					</div>


					@* Post content *@
					<a>
						<div class="sm:px-4 p-2.5 pt-0 w-full ">
							<p class="font-normal text-black">
								This is a sample post content. It can include text, images, or other media. Users can interact with the post by liking, commenting, or sharing it.
							</p>
						</div>
					</a>

					<a>
						<div class="relative w-full lg:h-96 h-full sm:px-4">
							<img src="~/images/placeholders/PlaceHolder.jpg" class="sm:rounded-lg w-full h-full object-cover"/>
						</div>
					</a>

					@* Icons *@
					<div class="sm:p-4 p-2.5 flex items-center gap-4 text-xs font-semibold">
						<div>
							<div class="flex items-center gap-2.5">
								<a class="button-icon text-red-500 bg-red-100">
									<ion-icon class="text-lg" name="heart"></ion-icon>
								</a>
								<a href="#" class="text-gray-700 font-semibold">24</a>
							</div>
						</div>

						<div class="flex items-center gap-3">
							<a class="button-icon text-gray-700">
								<ion-icon class="text-lg" name="chatbubble-ellipses-outline"></ion-icon>
							</a>
							<a href="#" class="text-gray-700">12</a>
						</div>

						<div class="ml-auto"></div>

						<div>
							<a class="button-icon ml-auto text-gray-700">
								<ion-icon class="text-lg" name="bookmark-outline"></ion-icon>
							</a>
						</div>
					</div>

					@* Add Comment Section *@
					<div>
						<div class="sm:px-4 sm:py-3 p-2.5 border-t border-gray-100 flex items-center gap-1">
							<img src="~/images/avatar/user.png" class="w-8 h-8 rounded-full" />
							<div class="flex-1 relative overflow-hidden h-10">
								<textarea placeholder="Add a comment..." rows="1" class="w-full resize-none !bg-transparent px-4 py-2 text-gray-800 placeholder:!text-gray-600 focus:!bg-transparent focus:!ring-transparent"></textarea>
							</div>
							<button class="text-sm rounded-full py-1.5 px-3.5 bg-secondery text-black">Comment</button>
						</div>
					</div>

				</div>

			</div>
		</div>
		<div class="flex-1">
			<div class="lg:space-y-4 lg:pb-8 max-lg:grid sm:gird-cols-3 max-lg:gap-2">
				<partial name="SideBar/FollowerSuggestions"></partial>
			</div>
			<div class="bg-white rounded-xl shadow-sm p-5 px-6 border1">
				<partial name="SideBar/_TrendsForYouSection"></partial>
			</div>
		</div>
	</div>
</main>
<partial name="Modals/_CreateStory"></partial>
<partial name="Modals/_CreateStatus"></partial>