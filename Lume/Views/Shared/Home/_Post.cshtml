@model Post

@{
	TimeSpan timeSpanSincePosted = DateTime.UtcNow.Subtract(Model.DateCreated);

	string displayTime = timeSpanSincePosted switch
	{
		var t when t.TotalDays >= 1 => $"{(int)t.TotalDays}d ago",
		var t when t.TotalHours >= 1 => $"{(int)t.TotalHours}h ago",
		var t when t.TotalMinutes >= 1 => $"{(int)t.TotalMinutes}m ago",
		_ => "Just now"
	};

	bool isFavorite = Model.favorites.Any(n => n.userId == 1);
	bool isLiked = Model.likes.Any(n => n.userId == 1);
}

<div class="bg-white rounded-xl shadow-sm text-sm font-medium border1">

	@* Post heading *@
	<div class="flex gap-3 sm:p-4 p-2.5 font-medium">
		<a>
			<img src="@(string.IsNullOrEmpty(Model.User.ProfilePictureUrl) ? "~/images/avatar/user.png" : Model.User.ProfilePictureUrl)" class="w-9 h-9 rounded-full">
		</a>
		<div class="flex-1">
			<a>
				<h4 class="text-black">
					@Model.User.fullName
				</h4>
				<div class="text-xs text-gray-500" title="@Model.DateCreated.ToString("MM/dd/yyyy HH:mm")">
					@displayTime
				</div>
			</a>
		</div>
		<div class="-mr-1">
			<button type="button" class="button-icon w-8 h-8 text-gray-500">
				<ion-icon class="text-xl" name="ellipsis-horizontal"></ion-icon>
			</button>
			<div class="w-[245px] !bg-white dark:!bg-white !border-slate-200 dark:!border-slate-200"
				 uk-dropdown="pos: bottom-right; animation: uk-animation-scale-up uk-transform-origin-top-right; animate-out:true; mode:click">
				<form>
					<button type="submit" class="!hover:bg-red-50 icon-link text-slate-700 dark:!text-slate-700">
						<ion-icon class="text-xl shrink-0" name="flag-outline"></ion-icon> Report
					</button>
				</form>
				<hr />
				<form>
					<button type="submit" class="!hover:bg-red-50 icon-link text-slate-700 dark:!text-slate-700">
						<ion-icon class="text-xl" name="lock-closed-outline"></ion-icon> Set as Private
					</button>
				</form>
				<hr />
				<form>
					<button type="submit" class="!hover:bg-red-50 icon-link text-slate-700 dark:!text-slate-700">
						<ion-icon class="text-xl" name="trash-bin-outline"></ion-icon> Delete Post
					</button>
				</form>
			</div>
		</div>
	</div>


	@* Post content *@
	<a>
		<div class="sm:px-4 p-2.5 pt-0 w-full ">
			<p class="font-normal text-black">
				@Model.Content
			</p>
		</div>
	</a>

	@if (!string.IsNullOrEmpty(Model.ImageUrl))
	{
		<a>
			<div class="relative w-full lg:h-96 h-full sm:px-4">
				<img src="@Model.ImageUrl" class="sm:rounded-lg w-full h-full object-cover" />
			</div>
		</a>

	}

	@* Icons *@
	<div class="sm:p-4 p-2.5 flex items-center gap-4 text-xs font-semibold">
		<div>
			<div class="flex items-center gap-2.5">
				<form asp-controller="Home" asp-action="TogglePostLike">
					<input type="hidden" name="PostId" value="@Model.Id" />
					<button type="submit" class="button-icon text-gray-700 @(isLiked ? "text-red-500 bg-red-100" : "")">
						<ion-icon class="text-lg" name="@(isLiked ? "heart" : "heart-outline")"></ion-icon>
					</button>
				</form>
				<a href="#" class="text-gray-700 font-semibold">@Model.likes.Count</a>
			</div>
		</div>

		<div class="flex items-center gap-3">
			<a class="button-icon text-gray-700">
				<ion-icon class="text-lg" name="chatbubble-ellipses-outline"></ion-icon>
			</a>
			<a href="#" class="text-gray-700">@Model.comments.Count</a>
		</div>

		<div class="ml-auto"></div>

		<div class="flex items-center gap-2.5">
			<form asp-controller="Home" asp-action="ToggleFavorite">
				<input type="hidden" name="postId" value="@Model.Id" />
				<button type="submit" class="button-icon ml-auto text-gray-700 @(isFavorite ? "text-orange-500 bt-orange-100" : "bookmark-outline")">
					<ion-icon class="text-lg" name="@(isFavorite ? "bookmark" : "bookmark-outline")"></ion-icon>
				</button>
			</form>
			@if(Model.favorites.Count > 0)
			{
				<a class="text-gray-700" href="#">@Model.favorites.Count</a>
			}
		</div>
	</div>

	@* Add Comment Section *@
	<div>
		<div class="p-2.5 border-t border-gray-100 font-normal space-y-3 relative">

			@foreach(var comment in Model.comments.OrderByDescending(n=> n.DateCreated).Take(3))
			{
				TimeSpan commenttimeSpanSincePosted = DateTime.UtcNow.Subtract(comment.DateCreated);

				string commentdisplayTime = commenttimeSpanSincePosted switch
				{
					var t when t.TotalDays >= 1 => $"{(int)t.TotalDays}d ago",
					var t when t.TotalHours >= 1 => $"{(int)t.TotalHours}h ago",
					var t when t.TotalMinutes >= 1 => $"{(int)t.TotalMinutes}m ago",
					_ => "Just now"
				};

				<div class="flex gap-3">
					<a>
						<img src="@(comment.User.ProfilePictureUrl ?? "~/images/avatar/user.png")" class=" w-6 h-6 mt-1 rounded-full">
					</a>
					<div class="flex-1">
						<div class="flex items-center justify-between">
							<a class="text-black font-medium">
								@comment.User.fullName
							</a>
							<small class="text-gray-500 text-xs">
								@commentdisplayTime
							</small>
						</div>
						<div class="flex items-center justify-between">
							<p class="mt-0.5 text-gray-800">
								@comment.Content
							</p>
							<form asp-controller="Home" asp-action="RemovePostComment">
								<input type="hidden" name="commentId" value="@comment.id" />
								<button type="submit" class="text-red-500 text-xs ml-2" title="Remove Post Comment">
									<ion-icon name="trash-outline">
									</ion-icon>
								</button>
							</form>
						</div>
					</div>
				</div>
			}

			@if(Model.comments.Count >= 3)
			{
				<div class="p-1.5 ">
					<a class="text-gray-800">
						Show All Comments
					</a>
				</div>
			}

		</div>
		<form asp-controller="Home" asp-action="AddPostComment">
			<div class="sm:px-4 sm:py-3 p-2.5 border-t border-gray-100 flex items-center gap-1">
				<img src="@(string.IsNullOrEmpty(Model.User.ProfilePictureUrl) ? "~/images/avatar/user.png" : Model.User.ProfilePictureUrl)" class="w-8 h-8 rounded-full" />

				<input type="hidden" name="PostId" value="@Model.Id" />
				<div class="flex-1 relative overflow-hidden h-10">
					<textarea name="Content" placeholder="Add a comment..." rows="1"
							  style="color:#1f2937 !important;"
							  class="w-full resize-none !bg-transparent px-4 py-2 text-gray-800 placeholder:!text-gray-600 focus:!bg-transparent focus:!ring-transparent"></textarea>
				</div>
				<button type="submit" class="text-sm rounded-full py-1.5 px-3.5 bg-secondery text-black">Comment</button>
			</div>
		</form>

	</div>
</div>