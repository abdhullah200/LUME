<div class="hidden lg:p-20" id="create-story" uk-modal="">
    <div class="uk-modal-dialog relative overflow-hidden mx-auto bg-white p-5 sm:p-7 shadow-xl rounded-lg md:w-[520px] w-[92%] max-h-[90vh] overflow-y-auto"
         role="dialog"
         aria-labelledby="create-story-title"
         aria-modal="true">
        <div class="flex items-center justify-center relative py-3 border-b border-gray-200 -mx-5 sm:-mx-7 mb-0 rounded-t-lg dark:border-slate-700">
            <h2 id="create-story-title" class="text-sm font-medium text-center text-black">
                Create Story
            </h2>
            <button type="button"
                    class="button__ico absolute top-1/2 right-3 -translate-y-1/2 uk-modal-close"
                    aria-label="Close">
                <svg fill="#000000" width="14" height="14" viewBox="-6 -6 24 24"
                     xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMinYMin"
                     class="jam jam-close" aria-hidden="true" focusable="false">
                    <path d="M7.314 5.9l3.535-3.536A1 1 0 1 0 9.435.95L5.899 4.485 2.364.95A1 1 0 1 0 .95 2.364l3.535 3.535L.95 9.435a1 1 0 1 0 1.414 1.414l3.535-3.535 3.536 3.535a1 1 0 1 0 1.414-1.414L7.314 5.899z" />
                </svg>
            </button>
        </div>

        <div class="space-y-5 mt-7">
            <form id="create-story-form" method="post" enctype="multipart/form-data">
                <div>
                    <div class="w-full h-72 relative -mx-7 border rounded-lg overflow-hidden bg-[url('/Add_background.png')] bg-repeat">
                        <label for="createStatusUrl"
                               class="flex flex-col justify-center items-center gap-2 cursor-pointer bg-gradient-to-t from-gray-700/60 py-4 absolute inset-x-0 bottom-0 w-full z-10">
                            <input id="createStatusUrl"
                                   name="uploadedContent"
                                   type="file"
                                   accept="image/png, image/jpeg"
                                   class="sr-only" />
                            <ion-icon name="image" class="text-3xl text-pink-600" aria-hidden="true"></ion-icon>
                            <span class="text-white mt-2">Browse to upload image</span>
                        </label>
                        <img id="createStoryPreview" alt="Story preview" class="w-full h-full object-cover hidden" />
                    </div>
                </div>

                <div class="flex justify-between items-center mt-6">
                    <div class="flex items-start gap-2">
                        <ion-icon name="time-outline" class="text-purple-600 rounded-full bg-pink-50 text-xl" aria-hidden="true"></ion-icon>
                        <p class="text-sm text-gray-500 font-medium">
                            Your status will be available <br />
                            for <span class="text-gray-800">24 Hours</span>
                        </p>
                    </div>
                    <button type="submit" class="button text-white px-8 rounded-md py-2 bg-gradient-to-r from-pink-500 to-purple-500 hover:opacity-80 transition">
                        Create
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>